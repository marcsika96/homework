# gemini or ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
# most tokens of one local answer, thinking included
OLLAMA_NUM_PREDICT=4096
# context window of a local model: prompt, tool results, thinking and answer together
OLLAMA_NUM_CTX=16384
# thinking of a local model: true, false, low, medium or high; empty: the model's default
OLLAMA_REASONING=
# where scripts/get_target.py clones from and to
TARGET_REPO_URL=
TARGET_REPO_PATH=data/target
MAX_TOOL_CALLS=8
REQUESTS_PER_MINUTE=10
